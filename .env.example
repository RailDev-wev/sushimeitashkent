# Public URL of the site (https, no trailing slash). Used for the bot's Mini App button.
NEXT_PUBLIC_SITE_URL=https://sushimei.uz

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Staff group where orders arrive. Add the bot to the group and send /chatid to get it (looks like -100…).
TELEGRAM_ORDERS_CHAT_ID=

# Any random string; Telegram sends it back with each webhook call. e.g. `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=
