# All of these live in Vercel → Settings → Environment Variables. Locally they're optional:
# without them orders are printed to the server console instead of Telegram.

# Optional. Public https URL (custom domain). Defaults to the Vercel production domain.
NEXT_PUBLIC_SITE_URL=

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Any long random string. Protects the webhook and /api/bot/setup.
TELEGRAM_WEBHOOK_SECRET=

# Staff group where orders arrive. Add the bot to the group and send /chatid to get it (looks like -100…).
TELEGRAM_ORDERS_CHAT_ID=

# Postgres for the stop-list and customer base. Added automatically by the Neon integration in Vercel
# (Storage → Create Database → Neon). Without it data is kept in memory (local dev only).
DATABASE_URL=
